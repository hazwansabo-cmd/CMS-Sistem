      "id": "cnt-001",
      "title": "School Holiday Camp: Young Huffaz & AI Robotics 2026",
      "message": "School holidays are just around the corner! Gift your children a transformative holiday experience combining modern visual Quran memorization and introductory AI Robotics at Al Amin Edu Oasis. 🌟\n\n🎯 Age Group: 7 - 14 years old\n📍 Venue: Main Campus, Bandar Baru Bangi\n🎁 Limited slots available for the first 30 early birds!",
      "cta_text": "Register Now & Enjoy 15% Discount",
      "cta_url": "https://alaminedu.com.my/huffaz-robotics-2026",
      "format": "carousel",
      "status": "scheduled",
